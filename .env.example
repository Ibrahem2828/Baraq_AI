# -----------------------------------------------------------------------------
# Baraq AI service - copy to .env and fill secrets on the server only.
# Never commit the real file or expose these values to the mobile app.
#
# *** THIS FILE'S DEFAULTS ARE FOR LOCAL LAB/DEV USE (mock provider, no real
# API calls, the Lab UI enabled). *** Before deploying to a real server, you
# MUST override these five to their production values, or the app silently
# keeps running in lab/dev mode against real traffic:
#   APP_ENV=production          (app/core/config.py's validate_production()
#                                 safety checks -- rejecting DEBUG=true, a
#                                 placeholder HMAC secret, a non-HTTPS backend
#                                 URL, etc. -- ONLY run when APP_ENV is exactly
#                                 "production"; leaving this as "development"
#                                 makes every one of those checks a silent no-op)
#   BARAQ_RUNTIME_MODE=service   (serves the real job API; "lab" mounts the
#                                 local testing UI instead of production routes)
#   ENABLE_AI_LAB=false
#   PROVIDER_MODE=live           (mock/replay never call OpenAI/Gemini for real)
#   BARAQ_HMAC_CURRENT_KEY_ID / BARAQ_HMAC_KEYS_JSON must be a real generated
#                                 secret shared with Django, not "django-dev-1"
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Baraq AI Service
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
PUBLIC_API_PREFIX=/api/ai/v1
INTERNAL_API_PREFIX=/internal/v1
ALLOWED_HOSTS=localhost,127.0.0.1,ai.baraqapp.com
CORS_ORIGINS=

# ==========================================
# BARAQ STANDALONE AI LAB
# ==========================================
BARAQ_RUNTIME_MODE=lab
ENABLE_AI_LAB=true
LAB_HOST=127.0.0.1
LAB_PORT=8000
LAB_STORAGE_DIR=.baraq_lab
LAB_MAX_UPLOAD_MB=100
LAB_MAX_TEXT_CHARS=2000000
LAB_MAX_OUTPUT_TOKENS=8000

# ==========================================
# PROVIDER MODE -- the single switch for the whole provider layer.
# mock/replay boot and run every pipeline with zero network calls and zero
# cost; only "live" requires real Gemini/OpenAI credentials below.
# ==========================================
PROVIDER_MODE=mock

# Gemini account (spec section 5: Gemini is the default economical choice for
# long/repetitive tasks once eval proves it meets the quality floor).
GEMINI_PRIMARY_ENABLED=false
GEMINI_PRIMARY_API_KEY=
GEMINI_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_PRIMARY_MONTHLY_BUDGET_USD=50
GEMINI_MODEL_HIGH_QUALITY=gemini-2.5-pro
GEMINI_MODEL_BALANCED=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_REQUEST_TIMEOUT_SECONDS=300

# ==========================================
# SADA LOCAL STT
# ==========================================
SADA_STT_PROVIDER=local_whisper
SADA_LOCAL_WHISPER_MODEL=small
SADA_LANGUAGE=ar

POSTGRES_PASSWORD=local_development_only
DATABASE_URL=postgresql+asyncpg://baraq_ai:local_development_only@postgres:5432/baraq_ai
DATABASE_SYNC_URL=postgresql+psycopg://baraq_ai:local_development_only@postgres:5432/baraq_ai
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Signed Django <-> AI service traffic. Never expose this secret to mobile clients.
BARAQ_BACKEND_BASE_URL=https://api.baraqapp.com
# Set true only when AI reaches Django through the private Docker hostname
# `backend`; public/internet callbacks must remain HTTPS.
BARAQ_BACKEND_ALLOW_INSECURE_HTTP=false
BARAQ_SERVICE_ID=baraq-ai-service
BARAQ_DJANGO_SERVICE_ID=baraq-django
# JSON keyring supports current and previous key IDs during rotation. Replace
# every value with a unique secret in staging/production; never use this local value there.
BARAQ_HMAC_CURRENT_KEY_ID=django-dev-1
BARAQ_HMAC_KEYS_JSON={"django-dev-1":"local-development-key-not-for-production"}
HMAC_MAX_CLOCK_SKEW_SECONDS=300
HMAC_NONCE_TTL_SECONDS=600
HMAC_V1_COMPAT_ENABLED=false
BARAQ_CALLBACK_TIMEOUT_SECONDS=15
BARAQ_HTTP_TIMEOUT_SECONDS=30
OUTBOX_DISPATCH_BATCH_SIZE=20
OUTBOX_LOCK_TIMEOUT_SECONDS=120
OUTBOX_RETRY_MAX_SECONDS=300

# OpenAI account 1 (primary)
OPENAI_PRIMARY_ENABLED=true
OPENAI_PRIMARY_API_KEY=
OPENAI_PRIMARY_PROJECT_ID=
OPENAI_PRIMARY_ORGANIZATION_ID=
OPENAI_PRIMARY_BASE_URL=https://api.openai.com/v1
OPENAI_PRIMARY_MONTHLY_BUDGET_USD=50

# OpenAI account 2 (secondary/failover or weighted capacity)
OPENAI_SECONDARY_ENABLED=false
OPENAI_SECONDARY_API_KEY=
OPENAI_SECONDARY_PROJECT_ID=
OPENAI_SECONDARY_ORGANIZATION_ID=
OPENAI_SECONDARY_BASE_URL=https://api.openai.com/v1
OPENAI_SECONDARY_MONTHLY_BUDGET_USD=50

# Model aliases are centralized here. They can be changed without code changes.
OPENAI_MODEL_HIGH_QUALITY=gpt-5.1
OPENAI_MODEL_BALANCED=gpt-5-mini
OPENAI_MODEL_FAST=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# mini-transcribe is the cost-optimized default for Sada; gpt-4o-transcribe-diarize
# is used automatically only when a job requests diarization (see app/pipelines/sada.py).
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_STORE_RESPONSES=false
OPENAI_REQUEST_TIMEOUT_SECONDS=300

# Routing policy: failover | weighted
PROVIDER_ROUTING_POLICY=failover
OPENAI_PRIMARY_WEIGHT=80
OPENAI_SECONDARY_WEIGHT=20
PROVIDER_MAX_RETRIES=2
PROVIDER_COOLDOWN_SECONDS=90
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5

# RAG
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE_CHARS=2200
RAG_CHUNK_OVERLAP_CHARS=300
RAG_TOP_K=10
RAG_RERANK_TOP_K=6
RAG_MAX_CONTEXT_CHARS=22000
RAG_MIN_SIMILARITY=0.20

# Limits
MAX_SOURCE_FILE_BYTES=52428800
MAX_AUDIO_FILE_BYTES=209715200
MAX_AUDIO_SECONDS=7200
MAX_REQUEST_TEXT_CHARS=100000
AI_REQUESTS_PER_MINUTE=20
JOB_RETENTION_DAYS=180
RAW_CONTENT_RETENTION_DAYS=30
TRAINING_CANDIDATE_RETENTION_DAYS=365
JOB_STALE_AFTER_SECONDS=900
JOB_MAX_RECOVERIES=2
TRAINING_CONSENT_REQUIRED=true

# Observability
SENTRY_DSN=
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
