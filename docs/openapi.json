    "/api/ai/v1/users/{user_id}/data": {
      "delete": {
        "tags": [
          "Django Gateway Data Deletion"
        ],
        "summary": "Delete User Data",
        "description": "Baraq_MD_Blueprint 02_AI_PLATFORM.md §12: on-demand deletion of a\nuser's (optionally one project's) AI jobs, outputs, ingested source\ncontent and cached results -- signed and callable only by Django, the\nsame trust boundary as job creation. `user_id` is part of the signed\ncanonical query string like the job GET/cancel endpoints, so it cannot\nbe spoofed independently of the HMAC signature.",
        "operationId": "delete_user_data_api_ai_v1_users__user_id__data_delete",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
